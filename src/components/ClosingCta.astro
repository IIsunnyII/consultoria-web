---
// CTA final centrado (#contacto): eyebrow, titular en dos tonos, texto, botón y email.
import Icon from './Icon.astro';
import { closing, site } from '../data/site';
---

<section id="contacto" class="closing-cta section-y container-site" aria-labelledby="contacto-title">
  <p class="eyebrow justify-center">{closing.eyebrow}</p>
  <h2 id="contacto-title" class="closing-title">
    <span class="block">{closing.title[0]}</span>
    <span class="tone-chrome block">{closing.title[1]}</span>
  </h2>
  <p class="mx-auto mt-[30px] max-w-[500px] text-[18px] text-muted">{closing.text}</p>
  <a href={closing.button.href} class="btn btn-primary mt-10">
    {closing.button.label}
    <Icon name="arrow-right" />
  </a>
  <a href={`mailto:${site.email}`} class="email-link">{site.email}</a>
</section>

<style>
  .closing-cta {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 140px 150px;
    text-align: center;
  }
  .closing-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(rgb(255 255 255 / .05), transparent 65%);
    pointer-events: none;
  }
  .closing-title {
    font-size: clamp(46px, 7.4vw, 106px);
    font-weight: 600;
    line-height: .94;
    letter-spacing: -.045em;
  }
  .email-link {
    margin-top: 24px;
    font-size: 14px;
    color: var(--color-muted);
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: color .3s, background-size .5s var(--ease-out-soft);
  }
  .email-link:hover { color: var(--color-text); background-size: 100% 1px; }
  @media (width <= 600px) {
    .closing-cta { padding-block: 90px; }
    .closing-title { font-size: 10.5vw; }
  }
</style>
