---
// Iconos de línea (24x24, trazo 1.5). Uso: <Icon name="arrow-right" class="size-5" />
export type IconName =
  | 'arrow-right' | 'arrow-up-right' | 'arrow-down' | 'chevron-down' | 'check' | 'menu' | 'close'
  | 'web' | 'game' | 'api' | 'data' | 'tools' | 'support';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className = 'size-5' } = Astro.props;

const paths: Record<IconName, string> = {
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8 7h9v9"/>',
  'arrow-down': '<path d="M12 5v14M6 13l6 6 6-6"/>',
  'chevron-down': '<path d="m7 10 5 5 5-5"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  menu: '<path d="M6 9.5h12M6 14.5h12"/>',
  close: '<path d="M7 7l10 10M17 7 7 17"/>',
  web: '<rect x="3" y="4.5" width="18" height="15" rx="2.5"/><path d="M3 9h18M6.5 6.8h.01M9 6.8h.01"/>',
  game: '<path d="M7.5 8h9a4.5 4.5 0 0 1 4.4 5.5l-.6 2.7a2.3 2.3 0 0 1-3.9 1.1L14.5 15h-5l-1.9 2.3a2.3 2.3 0 0 1-3.9-1.1l-.6-2.7A4.5 4.5 0 0 1 7.5 8Z"/><path d="M8 10.5v3M6.5 12h3M15.5 11.5h.01M17 13h.01"/>',
  api: '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14"/>',
  data: '<ellipse cx="12" cy="6" rx="7" ry="2.8"/><path d="M5 6v6c0 1.5 3.1 2.8 7 2.8s7-1.3 7-2.8V6M5 12v6c0 1.5 3.1 2.8 7 2.8s7-1.3 7-2.8v-6"/>',
  tools: '<path d="M14.5 6.5a3.5 3.5 0 0 0 4.6 4.6L20 12l-8 8-3.5-3.5 8-8"/><path d="m4 4 5 5M4 4l1.5 4L9 9"/>',
  support: '<path d="M4 13v-1a8 8 0 0 1 16 0v1"/><rect x="3.5" y="13" width="4" height="6" rx="1.5"/><rect x="16.5" y="13" width="4" height="6" rx="1.5"/><path d="M18.5 19c0 1.5-2 2.5-5 2.5"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
