---
// Tarjeta grande de proyecto. En escritorio es sticky y se apila (ver Projects.astro).
// Muestra la captura `image` o, si no hay, una vista previa dibujada con CSS.
import Icon from './Icon.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
const { preview } = project;
const href = project.demo ?? project.repo ?? '#contacto';
const external = href.startsWith('http');
---

<article class="project-card" data-stack-card style={`--i:${index}`}>
  <div class="stack-inner" data-stack-inner>
  <div class="card-reveal" data-reveal>
    <!-- Enlace que cubre toda la tarjeta -->
    <a
      href={href}
      class="card-link"
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
      aria-label={`Ver el proyecto ${project.title}: ${project.summary}`}
    ></a>
    <div class="project-art">
      {project.image ? (
        <img class="project-img" src={project.image} alt="" width="1280" height="750" loading="lazy" decoding="async" />
      ) : (
        <div class:list={['project-preview', `tone-${preview.tone}`]} aria-hidden="true">
          <div class="preview-deco"></div>
          <div class="preview-nav">
            <b>{preview.brand}</b>
            <div>{preview.nav.map((item) => <span>{item}</span>)}</div>
          </div>
          <div class="preview-copy">
            <span class="preview-kicker">{preview.kicker}</span>
            <p class="preview-headline">{preview.headline[0]}<br />{preview.headline[1]}</p>
            <span class="preview-pill">{preview.pill}<Icon name="arrow-up-right" class="size-[1em]" /></span>
          </div>
          <p class="preview-caption">{preview.caption}</p>
        </div>
      )}
      <span class="project-open" aria-hidden="true"><Icon name="arrow-up-right" class="size-5" /></span>
    </div>

    <div class="project-meta">
      <p class="meta-kicker">{project.category}</p>
      <h3 class="project-title">{project.title}</h3>
      <ul class="project-tags" aria-label="Detalles">
        <li class="tag-status" data-status={project.status}>{project.status} · {project.year}</li>
        {project.tags.map((t) => <li>{t}</li>)}
      </ul>
      {project.repo && (
        <a href={project.repo} target="_blank" rel="noopener noreferrer" class="meta-repo">
          Repositorio <Icon name="arrow-up-right" class="size-3.5" />
        </a>
      )}
    </div>
  </div>
  </div>
</article>

<style>
  .project-card {
    position: sticky;
    top: 110px;
    margin-bottom: 85px;
  }
  .project-card:last-child { margin-bottom: 0; }

  .stack-inner {
    position: relative;
    transform-origin: 50% 0;
    will-change: transform;
  }
  /* Sombra que oscurece la tarjeta cuando la siguiente la cubre (--shade 0 → 1) */
  .stack-inner::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: 32px;
    background: #000;
    opacity: calc(var(--shade, 0) * .55);
    pointer-events: none;
  }

  /* ---------- Arte ---------- */
  .project-art {
    position: relative;
    height: 750px;
    max-height: calc(100svh - 140px);
    min-height: 520px;
    overflow: hidden;
    border-radius: 32px;
    background: #222;
    container-type: inline-size;
  }
  .project-img, .project-preview {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: transform 1.2s var(--ease-out-soft);
  }
  .project-img { object-fit: cover; }
  .project-card:hover .project-img,
  .project-card:hover .project-preview { transform: scale(1.025); }

  .project-open {
    position: absolute;
    top: 22px;
    right: 23px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(255 255 255 / .19);
    border-radius: 50%;
    background: rgb(0 0 0 / .27);
    color: #fff;
    -webkit-backdrop-filter: blur(15px);
    backdrop-filter: blur(15px);
    transition: background-color .4s var(--ease-out-soft), color .4s, transform .5s var(--ease-out-soft);
  }
  .project-card:hover .project-open {
    background: #fff;
    color: #000;
    transform: rotate(45deg);
  }

  /* ---------- Vista previa dibujada ---------- */
  .project-preview {
    --ink: #f2f2f2;
    display: flex;
    flex-direction: column;
    padding: clamp(18px, 2.6cqi, 34px) clamp(20px, 3.4cqi, 44px);
    color: var(--ink);
    overflow: hidden;
  }
  .preview-deco { position: absolute; inset: 0; pointer-events: none; }

  .tone-bone { --ink: #151515; background: linear-gradient(160deg, #e3dfd5, #c9c4b8); }
  .tone-bone .preview-deco {
    background:
      radial-gradient(circle at 74% 46%, #1a1a1a 0 13cqi, transparent 13.1cqi),
      radial-gradient(circle at 74% 46%, transparent 0 18cqi, rgb(0 0 0 / .12) 18.1cqi 18.25cqi, transparent 18.4cqi),
      linear-gradient(transparent 78%, rgb(0 0 0 / .1) 78% 78.2%, transparent 78.3%);
  }
  .tone-graphite { background: radial-gradient(70% 90% at 80% 20%, #3a3a3e, #121214 60%, #09090a); }
  .tone-graphite .preview-deco {
    background-image:
      linear-gradient(rgb(255 255 255 / .06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / .06) 1px, transparent 1px),
      radial-gradient(circle at 72% 42%, rgb(255 255 255 / .55), rgb(255 255 255 / .08) 9cqi, transparent 22cqi);
    background-size: 4.5cqi 4.5cqi, 4.5cqi 4.5cqi, 100% 100%;
    mask-image: linear-gradient(90deg, transparent 10%, #000 55%);
  }
  .tone-steel { background: linear-gradient(150deg, #9aa0a8, #565b63 45%, #23262b); }
  .tone-steel .preview-deco {
    background:
      linear-gradient(#fff, #fff) 66% 28% / 22cqi 15cqi no-repeat,
      linear-gradient(rgb(255 255 255 / .55), rgb(255 255 255 / .55)) 88% 44% / 15cqi 22cqi no-repeat,
      linear-gradient(rgb(0 0 0 / .35), rgb(0 0 0 / .35)) 70% 74% / 26cqi 9cqi no-repeat;
    opacity: .35;
    filter: blur(.2px);
  }

  .preview-nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6cqi;
    padding-right: 64px;
  }
  .preview-nav b { font-size: clamp(16px, 2.05cqi, 26px); font-weight: 700; letter-spacing: -.05em; }
  .preview-nav div { display: flex; gap: clamp(10px, 2.2cqi, 28px); margin-left: auto; margin-right: 18cqi; }
  .preview-nav span { font-size: clamp(8px, 1cqi, 13px); font-weight: 500; white-space: nowrap; opacity: .85; }

  .preview-copy { position: relative; margin-top: auto; margin-bottom: auto; padding-top: 4cqi; }
  .preview-kicker { font-size: clamp(9px, 1.1cqi, 14px); font-weight: 600; }
  .preview-headline {
    margin-top: 1.4cqi;
    font-size: clamp(30px, 7.2cqi, 92px);
    font-weight: 600;
    line-height: .92;
    letter-spacing: -.055em;
    opacity: .9;
  }
  .preview-pill {
    display: inline-flex;
    align-items: center;
    gap: 1.4cqi;
    margin-top: 2.4cqi;
    padding: clamp(6px, .8cqi, 10px) clamp(10px, 1.4cqi, 18px);
    border-radius: 999px;
    background: var(--ink);
    color: color-mix(in srgb, var(--ink), #000 0%);
    font-size: clamp(8px, 1cqi, 13px);
    font-weight: 600;
  }
  .tone-bone .preview-pill { color: #e3dfd5; }
  .tone-graphite .preview-pill, .tone-steel .preview-pill { color: #111; }
  .preview-caption {
    position: absolute;
    right: clamp(20px, 3.4cqi, 44px);
    bottom: clamp(18px, 2.6cqi, 34px);
    max-width: max(20cqi, 150px);
    font-size: clamp(8px, 1cqi, 13px);
    line-height: 1.4;
    text-align: right;
    opacity: .75;
  }

  /* ---------- Panel de datos (vidrio) ---------- */
  .project-meta {
    position: absolute;
    left: 24px;
    bottom: 24px;
    z-index: 2;
    min-width: 320px;
    max-width: 440px;
    padding: 24px 28px;
    border-radius: 24px;
    background: linear-gradient(rgb(11 11 11 / .44), rgb(11 11 11 / .6));
    box-shadow: var(--shadow-card);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    backdrop-filter: blur(20px) saturate(1.4);
  }
  .meta-kicker { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #dfdfe5; }
  .project-title {
    margin-top: 8px;
    font-size: 46px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -.04em;
  }
  .card-link { position: absolute; inset: 0; z-index: 1; border-radius: 32px; }
  .card-link:focus-visible { outline: 2px solid var(--color-text); outline-offset: 4px; }
  .project-meta { pointer-events: none; }
  .meta-repo { pointer-events: auto; }

  .project-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 18px; }
  .project-tags li {
    padding: 6px 12px;
    border: 1px solid rgb(255 255 255 / .19);
    border-radius: 30px;
    background: rgb(0 0 0 / .13);
    font-size: 10px;
    letter-spacing: .04em;
    color: #d0d0d0;
  }
  .tag-status { display: inline-flex; align-items: center; gap: 7px; color: var(--color-text) !important; }
  .tag-status::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .tag-status[data-status="En desarrollo"]::before { background: transparent; box-shadow: inset 0 0 0 1px currentColor; }
  .tag-status[data-status="Confidencial"] { color: var(--color-muted) !important; }

  .meta-repo {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    font-size: 13px;
    color: var(--color-muted);
    transition: color .3s;
  }
  .meta-repo:hover { color: var(--color-text); }

  /* ---------- Móvil: sin sticky, panel debajo ---------- */
  @media (width <= 850px) {
    .project-card { position: relative; top: 0; margin-bottom: 32px; }
    .stack-inner { transform: none !important; }
    .stack-inner::after { display: none; }
    .project-art { height: auto; min-height: 0; max-height: none; aspect-ratio: 1.08; border-radius: 18px; }
    .project-open { top: 14px; right: 14px; width: 38px; height: 38px; }
    .project-meta {
      position: relative;
      left: 0;
      bottom: 0;
      min-width: 0;
      max-width: none;
      margin-top: 10px;
      padding: 20px 22px;
      border-radius: 18px;
      background: linear-gradient(rgb(255 255 255 / .06), rgb(255 255 255 / .02));
    }
    .project-title { font-size: 30px; }
    .card-link { border-radius: 18px; }
  }
  @media (width > 600px) and (width <= 850px) { .project-art { aspect-ratio: 16 / 10; } }
</style>
