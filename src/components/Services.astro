---
// Servicios: grid 3×2 dentro de una sola tarjeta, con divisores de 1px (patrón de Relay).
// Datos en src/data/services.ts (también los usa el menú del header).
import Icon from './Icon.astro';
import SplitHeading from './SplitHeading.astro';
import { services } from '../data/services';
---

<section id="servicios" class="section-y container-site" aria-labelledby="servicios-title">
  <SplitHeading
    id="servicios-title"
    eyebrow="Servicios"
    title={['Un solo equipo.', 'Todo el ciclo del software.']}
    text="Desde la primera idea hasta el mantenimiento. Elegimos la herramienta adecuada para cada problema, no al revés."
    link={{ label: 'Cuéntanos qué necesitas', href: '#contacto' }}
  />

  <ul class="services-grid card" data-reveal>
    {services.map((s) => (
      <li class="service">
        <div class="flex items-start justify-between gap-4">
          <span class="label">{s.kicker}</span>
          <span class="service-icon"><Icon name={s.icon} class="size-[18px]" /></span>
        </div>
        <h3 class="text-title mt-auto pt-10">{s.title}</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-muted">{s.description}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
  }
  .service {
    display: flex;
    flex-direction: column;
    min-height: 230px;
    padding: 30px 32px 34px;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    transition: background-color .35s;
  }
  .service:nth-child(3n) { border-right: 0; }
  .service:nth-last-child(-n + 3) { border-bottom: 0; }
  .service:hover { background: rgb(255 255 255 / .025); }
  .service-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    color: var(--color-muted);
    transition: color .3s, background-color .4s var(--ease-out-soft);
  }
  .service:hover .service-icon { color: var(--color-bg); background: var(--color-text); }

  @media (width <= 1100px) {
    .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .service:nth-child(3n) { border-right: 1px solid var(--color-line); }
    .service:nth-child(2n) { border-right: 0; }
    .service:nth-last-child(-n + 3) { border-bottom: 1px solid var(--color-line); }
    .service:nth-last-child(-n + 2) { border-bottom: 0; }
  }
  @media (width <= 600px) {
    .service { min-height: 205px; padding: 22px 18px; }
  }
  @media (width <= 420px) {
    .services-grid { grid-template-columns: 1fr; }
    .service, .service:nth-child(n) { border-right: 0; border-bottom: 1px solid var(--color-line); }
    .service:last-child { border-bottom: 0; }
  }
</style>
