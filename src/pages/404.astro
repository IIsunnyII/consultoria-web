---
// Página 404: mismo lenguaje visual, sin indexar.
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { withBase } from '../utils/url';
---

<Layout title={`Página no encontrada — ${site.name}`} noindex>
  <main id="main" class="grid min-h-svh place-items-center px-5 text-center">
    <div class="flex flex-col items-center">
      <p class="pill">Error 404</p>
      <h1 class="text-display mt-8">
        <span class="block">Aquí no hay nada.</span>
        <span class="tone-chrome block">Todavía.</span>
      </h1>
      <p class="mt-8 max-w-[480px] text-lead text-muted max-sm:text-[17px]">
        La página que buscas no existe o cambió de lugar.
      </p>
      <a href={withBase("/")} class="btn btn-primary mt-10">Volver al inicio <Icon name="arrow-right" /></a>
    </div>
  </main>
</Layout>
